#
# App-wide defaults only. Do NOT add per-type stanzas ([savedsearches],
# [macros], ...) with an `access` line here: a type stanza in default.meta
# is more specific than the `[]` stanza in a client's local.meta and would
# override it, silently stripping write access from any client-specific
# role. Keep all ACL handling in `[]` so local.meta stays authoritative.
#
# Macros are deliberately NOT exported to system scope. Client exception
# macros live in local/macros.conf of this same app and resolve in app
# context. Exporting them, or splitting the searches into a second app,
# breaks that.
#
[]
access = read : [ * ], write : [ admin, power, splunkaiagent ]
export = none

[eventtypes]
export = system

[props]
export = system

[transforms]
export = system

[lookups]
export = system
