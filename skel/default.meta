#
# Replace with the metadata/default.meta from your currently deployed app.
#
# Macros are deliberately NOT exported to system scope. Client exception
# macros live in local/macros.conf of this same app and resolve in app
# context. Exporting them, or splitting the searches into a second app,
# breaks that.
#
[]
access = read : [ * ], write : [ admin, power, splunkaiagent ]
export = none

# The agent role edits savedsearches (enable/disable, tune) and macros
# (per-client exceptions). Both inherit the app-level ACL above; listed
# explicitly so a future change to [] does not silently drop them.
[savedsearches]
access = read : [ * ], write : [ admin, power, splunkaiagent ]

[macros]
access = read : [ * ], write : [ admin, power, splunkaiagent ]

[eventtypes]
export = system

[props]
export = system

[transforms]
export = system

[lookups]
export = system
